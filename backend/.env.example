# MongoDB connection string (MongoDB Atlas strongly recommended for serverless)
# Create a cluster at https://www.mongodb.com/atlas, add a database user, and
# get the connection string from "Driver" → Node.js, e.g.:
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/svg_readme?retryWrites=true&w=majority
MONGODB_URI="mongodb://root:@localhost:27017/svg_readme"

# Backend Server Port
PORT=3001